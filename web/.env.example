DATABASE_URL=postgres://yash:yash_dev_password@localhost:5432/yash_poultry

# --- Login (V13). See docs/AUTH.md. None of these has a real value here; the real ones live only in Vercel. ---
# Hash of the owner password:   npx tsx scripts/make-password-hash.mts   (type "owner" when asked)
# APP_PASSWORD_HASH=<paste here>
# Hash of the staff PIN (4 to 6 digits; staff can only upload photos):   same script, type "staff"
# APP_STAFF_PIN_HASH=<paste here>
# Random secrets:   npx tsx scripts/make-secret.mts
# SESSION_SECRET=<paste here>
# CRON_SECRET=<paste here>
# Developer machine only, ignored by a production build and by Vercel: switches the login off. Never set it anywhere else.
# LOGIN_DISABLED_FOR_DEV=1
